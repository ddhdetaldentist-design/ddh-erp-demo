# DDH Dental Lab ERP — Environment Variables

# ─── Database (Choose ONE) ───────────────────────────────

# OPTION A: Supabase (Online)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# OPTION B: Local PostgreSQL (Offline)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ddh_db"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/ddh_db"

# ─── Auth ────────────────────────────────────────────────
NEXTAUTH_SECRET="CHANGE_ME_TO_RANDOM_32_CHAR_STRING"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="DDH Dental Lab"
NEXT_PUBLIC_APP_VERSION="1.0.0"
